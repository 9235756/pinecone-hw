# ===== local.env — подставьте свои ключи (файл НЕ коммитить в Git!) =====
# ProxyAPI (доступ к OpenAI Embeddings из РФ): https://proxyapi.ru -> Ключи API
PROXYAPI_KEY=sk-proxyapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Pinecone: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=pcsk_XXXXXX_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PINECONE_INDEX=auto-brands-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=cars

# Telegram-бот (опционально): @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# MOCK=1 — эмуляция без реальных API; MOCK=0 — реальные API
MOCK=1
TOP_K=3
